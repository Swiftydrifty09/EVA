AI_PROVIDER=local

# OpenAI requires an API key and may incur separate usage charges.
# AI_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# To use Ollama instead, set AI_PROVIDER=ollama and configure these values.
# OLLAMA_URL=http://127.0.0.1:11434/api/chat
# OLLAMA_MODEL=jarvis-tech/Jarvis_Distilled_v1:latest

# To use LocalAI, set AI_PROVIDER=localai and configure these values.
# LOCALAI_BASE_URL=http://127.0.0.1:8080/v1
# LOCALAI_MODEL=your-installed-model-name
# LOCALAI_API_KEY=
